# Existing values retained from the current Splunk relay
RELAY_LISTEN_HOST=REPLACE_WITH_RELAY_ADDRESS
RELAY_LISTEN_PORT=8766
RELAY_ALLOWED_SOURCE=REPLACE_WITH_SOC_ADDRESS
RELAY_TOKEN=REPLACE_WITH_RANDOM_SPLUNK_ROUTE_TOKEN
RELAY_UPSTREAM=https://example.invalid/webhook/splunk-alert-to-case

# Cached CTI/Shodan broker
RELAY_ENRICHMENT_URL=http://REPLACE_WITH_CTI_BROKER_ADDRESS:8780/v1/enrich
RELAY_ENRICHMENT_TOKEN=REPLACE_WITH_RANDOM_BROKER_TOKEN
RELAY_ENRICHMENT_TIMEOUT=12
RELAY_ENRICHMENT_DEADLINE=15
RELAY_MAX_BODY=1048576
RELAY_MAX_RESPONSE=1048576
RELAY_MAX_CONNECTIONS=16
RELAY_READ_TIMEOUT=5
RELAY_CONNECTION_DEADLINE=15

# Separate Wazuh route
RELAY_WAZUH_TOKEN=REPLACE_WITH_RANDOM_WAZUH_ROUTE_TOKEN
RELAY_WAZUH_UPSTREAM=https://example.invalid/webhook/wazuh-alert-triage-staged
RELAY_UPSTREAM_TIMEOUT=90
RELAY_UPSTREAM_DEADLINE=120
