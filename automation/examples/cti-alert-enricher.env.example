# Broker listener and source policy
ENRICHER_LISTEN_HOST=REPLACE_WITH_CTI_VM_ADDRESS
ENRICHER_LISTEN_PORT=8780
ENRICHER_ALLOWED_SOURCES=REPLACE_WITH_SOC_ADDRESS,127.0.0.1

# The systemd unit supplies opencti_token, shodan_api_key, and
# enricher_bearer_token through LoadCredential=. Never place them here.
OPENCTI_URL=http://REPLACE_WITH_CTI_VM_ADDRESS:8080

# Cache and provider controls
ENRICHER_CACHE_PATH=/var/lib/cti-alert-enricher/cache.db
ENRICHER_POSITIVE_TTL=86400
ENRICHER_NEGATIVE_TTL=3600
ENRICHER_MAX_OBSERVABLES=3
ENRICHER_PROVIDER_TIMEOUT=8
ENRICHER_OUTBOUND_DEADLINE=15
ENRICHER_PROVIDER_MAX_RESPONSE=524288
ENRICHER_MAX_BODY=524288
ENRICHER_MAX_CONNECTIONS=16
ENRICHER_READ_TIMEOUT=5
ENRICHER_CONNECTION_DEADLINE=15
ENRICHER_MAX_CACHE_ROWS=10000
ENRICHER_MAX_CACHE_BYTES=67108864
